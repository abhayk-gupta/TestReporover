# ==============================================================================
# LegalBuddy Environment Variables Configuration Template
# Duplicate this file as '.env' and populate the actual cryptographic credentials.
# ==============================================================================

# --- Vector Database (Pinecone) ---
# Primary dense retrieval index API token for statutory knowledge bases
PINECONE_API_KEY=your_pinecone_api_key_here

# --- Inference Engine API (Groq) ---
# High-concurrency LLM token for multi-agent execution routing and streaming generation
GROQ_API_KEY=your_groq_api_key_here

# --- Real-Time Search Tool (Tavily) ---
# Web-crawler API key for fallback internet legal lookups and validation checks
TAVILY_API_KEY=your_tavily_api_key_here

# --- Relational Storage Database (NeonDB Postgres) ---
# Serverless connection string tracking authenticated user profiles and chat threads
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require

# --- Semantic Caching Stratum (Upstash Vector) ---
# Dense mathematical embedding REST endpoint coordinates (Type: Dense, Dimensions: 384)
UPSTASH_VECTOR_REST_URL=https://your-index-name.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_rest_token_here

# --- Frontend Client Configuration ---
# Target network route used by Next.js to communicate with the FastAPI stream pipeline
NEXT_PUBLIC_API_URL=http://localhost:8000
